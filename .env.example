# Optional overrides — copy this file to .env and edit as needed.

# How many milliseconds to pause between processing each job.
# Default is 1500 ms. Increase if you're hitting rate-limits.
# JOB_PAUSE_MS=1500

# Maximum time (ms) to wait for the application modal to appear after clicking Apply.
# Default is 5000 ms.
# MODAL_TIMEOUT_MS=5000
